{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "mre-wry-deadlock",
  "version": "0.1.0",
  "identifier": "com.mre.wry-arm64-deadlock",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MRE: wry ARM64 WebView2 Deadlock",
        "width": 1200,
        "height": 800,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "resizable": true,
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "tabbingIdentifier": null,
        "additionalBrowserArgs": "--disable-features=MediaRouter"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:window:allow-set-size",
            "core:window:allow-set-focus",
            "core:window:allow-set-resizable",
            "core:window:allow-set-min-size",
            "core:window:allow-set-position",
            "core:window:allow-inner-size",
            "core:window:allow-outer-position",
            "core:event:allow-listen",
            "core:event:default",
            "process:allow-exit"
          ]
        }
      ]
    }
  }
}